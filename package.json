{
  "name": "mantine-view",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components theme.ts",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx,css}\"",
    "test": "npm run format:test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@mantine/carousel": "9.6.3",
    "@mantine/code-highlight": "9.6.3",
    "@mantine/core": "9.6.3",
    "@mantine/dropzone": "9.6.3",
    "@mantine/form": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/spotlight": "9.6.3",
    "@tabler/icons-react": "^3.36.1",
    "dayjs": "^1.11.19",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "oxc-config-mantine": "^1.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.6",
